#!/usr/bin/env bash
#
# SheetHub — a GitLab-style DevOps forge whose data plane is a spreadsheet.
# CLI tool for repository metadata, issues, merge requests, releases, and manifests.
#
# Connects to the SheetHub Apps Script apiserver (or local mock server).
#
# Config via env (or a .sheethub.env / .skctl.env file next to this script):
#   SHEETHUB_URL=http://localhost:8788/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Usage:
#   sheethub repo list
#   sheethub issue list <repo>
#   sheethub issue create <repo> <title> [body]
#   sheethub mr list <repo>
#   sheethub mr view <mr_id_or_number> [repo]
#   sheethub mr merge <mr_id_or_number> [repo]
#   sheethub file get <repo> <path>
#   sheethub file put <repo> <path> <local_file>
#   sheethub release list <repo>
#   sheethub registry list [repo]
#   sheethub registry push <repo> <name:tag> <local_file_or_image_tar>
#   sheethub registry pull <repo> <name:tag_or_digest> [output_file_or_dir]
#   sheethub registry view <repo> <name:tag_or_digest>
#   sheethub registry delete <repo> <name:tag_or_digest>
#   sheethub tour
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=/dev/null
[ -f "$here/.sheethub.env" ] && . "$here/.sheethub.env"
# shellcheck source=/dev/null
[ -f "$here/.skctl.env" ] && [ -z "${SHEETHUB_URL:-}" ] && [ -n "${WEBAPP_URL:-}" ] && SHEETHUB_URL="$WEBAPP_URL"
SHEETHUB_URL="${SHEETHUB_URL:-http://localhost:8788/exec}"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

command -v jq >/dev/null 2>&1 || { echo "sheethub: jq not found (install jq)" >&2; exit 1; }

urlencode() {
  jq -rn --arg v "$1" '$v|@uri'
}

api_get() {
  local query="$1"
  local res
  res="$(curl -fsSL -m 30 "$SHEETHUB_URL?token=$(urlencode "$TOKEN")&$query")"
  if echo "$res" | jq -e '.error' >/dev/null 2>&1; then
    echo "sheethub error: $(echo "$res" | jq -r .error)" >&2
    exit 1
  fi
  echo "$res"
}

api_post() {
  local payload="$1"
  local res
  res="$(curl -fsSL -m 30 -X POST "$SHEETHUB_URL" -H 'Content-Type: application/json' -d "$payload")"
  if echo "$res" | jq -e '.error' >/dev/null 2>&1; then
    echo "sheethub error: $(echo "$res" | jq -r .error)" >&2
    exit 1
  fi
  echo "$res"
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  get)
    kind="${1:-repos}"
    case "$kind" in
      repos|repo)
        api_get "kind=repos" | jq -r '["NAME","DEFAULT_BRANCH","VISIBILITY","STARS","UPDATED"], (.items[]|[.name,.default_branch,.visibility,(.stars_count|tostring),.updated_at]) | @tsv' | column -t -s $'\t'
        ;;
      issues|issue)
        repo="${2:-}"
        q="kind=issues"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["#","REPO","STATE","AUTHOR","TITLE"], (.items[]|[.number,.repo,.state,.author,.title]) | @tsv' | column -t -s $'\t'
        ;;
      mrs|mr|mergerequests)
        repo="${2:-}"
        q="kind=mergerequests"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["!","REPO","BRANCHES","STATE","AUTHOR","TITLE"], (.items[]|[.number,.repo,(.source_branch + " -> " + .target_branch),.state,.author,.title]) | @tsv' | column -t -s $'\t'
        ;;
      releases|rel)
        repo="${2:-}"
        q="kind=releases"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["TAG","REPO","NAME","ASSETS"], (.items[]|[.tag_name,.repo,.name,.assets]) | @tsv' | column -t -s $'\t'
        ;;
      files|file)
        repo="${2:-}"
        q="kind=files"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["REPO","PATH","BRANCH","UPDATED"], (.items[]|[.repo,.path,.branch,.updated_at]) | @tsv' | column -t -s $'\t'
        ;;
      registry|images|image)
        repo="${2:-}"
        q="kind=images"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["REPO","IMAGE","TAG","CONFIG DIGEST","SIZE","LAYERS","CREATED"], (.items[]|[.repo,.name,(.tag // (.name|split(":")[1] // "latest")),(.digest[0:19] + "..."),(((.size // .size_bytes)|tostring) + " B"),((.layers[0:19] // ((.chunk_count|tostring) + " cells")) + "..."),(.created // .created_at // .updated_at)]) | @tsv' | column -t -s $'\t'
        ;;
      *)
        echo "unknown kind: $kind (expected: repos, issues, mrs, releases, files, images)" >&2; exit 1
        ;;
    esac
    ;;

  repo)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get repos ;;
      *) echo "unknown repo command: $sub" >&2; exit 1 ;;
    esac
    ;;

  issue)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get issues "$@" ;;
      create)
        repo="${1:?usage: sheethub issue create <repo> <title> [body]}"
        title="${2:?missing issue title}"
        body="${3:-}"
        api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg tit "$title" --arg b "$body" '{token:$t, action:"create_issue", repo:$r, title:$tit, body:$b}')" | jq .
        ;;
      *) echo "unknown issue command: $sub" >&2; exit 1 ;;
    esac
    ;;

  mr)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get mrs "$@" ;;
      view)
        id="${1:?usage: sheethub mr view <id_or_number> [repo]}"
        repo="${2:-}"
        q="kind=mergerequests&id=$(urlencode "$id")"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq '.items[0] // {error: "MR not found"}'
        ;;
      merge)
        id="${1:?usage: sheethub mr merge <mr_id_or_number> [repo]}"
        repo="${2:-}"
        api_post "$(jq -n --arg t "$TOKEN" --arg id "$id" --arg r "$repo" '{token:$t, action:"merge_mr", mr_id:$id, repo:$r}')" | jq .
        ;;
      *) echo "unknown mr command: $sub" >&2; exit 1 ;;
    esac
    ;;

  file)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get files "$@" ;;
      get)
        repo="${1:?usage: sheethub file get <repo> <path>}"
        path="${2:?missing file path}"
        res="$(api_get "kind=files&repo=$(urlencode "$repo")")"
        echo "$res" | jq -r --arg p "$path" '.items[] | select(.path == $p) | .content'
        ;;
      put)
        repo="${1:?usage: sheethub file put <repo> <path> <local_file>}"
        path="${2:?missing file path}"
        file="${3:?missing local file}"
        content="$(cat "$file")"
        api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg p "$path" --arg c "$content" '{token:$t, action:"put_file", repo:$r, path:$p, content:$c}')" | jq .
        ;;
      *) echo "unknown file command: $sub" >&2; exit 1 ;;
    esac
    ;;

  release)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get releases "$@" ;;
      *) echo "unknown release command: $sub" >&2; exit 1 ;;
    esac
    ;;

  registry|image)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list)
        "$0" get images "$@"
        ;;
      view)
        repo="${1:?usage: sheethub registry view <repo> <name:tag_or_digest>}"
        img_spec="${2:?missing image name:tag or digest}"
        img_spec="${img_spec#sicf:}"
        if [[ "$img_spec" == sha256:* ]]; then
          api_get "kind=images&repo=$(urlencode "$repo")&digest=$(urlencode "$img_spec")" | jq '.items[0] // {error: "image not found"}'
        else
          name="${img_spec%%:*}"
          tag="latest"
          [[ "$img_spec" == *:* ]] && tag="${img_spec#*:}"
          api_get "kind=images&repo=$(urlencode "$repo")&name=$(urlencode "$name")&tag=$(urlencode "$tag")" | jq '.items[0] // {error: "image not found"}'
        fi
        ;;
      push)
        repo="${1:?usage: sheethub registry push <repo> <name:tag> <local_file_or_image_tar>}"
        img_spec="${2:?missing image name:tag}"
        img_spec="${img_spec#sicf:}"
        file="${3:?missing local file}"
        [ -f "$file" ] || { echo "sheethub error: file not found: $file" >&2; exit 1; }

        name="${img_spec%%:*}"
        tag="latest"
        [[ "$img_spec" == *:* ]] && tag="${img_spec#*:}"

        echo "📦 Preparing SICF container image & layers for spreadsheet storage..."
        payload="$(TOKEN="$TOKEN" node -e '
          const fs = require("fs");
          const crypto = require("crypto");
          const file = process.argv[1];
          const repo = process.argv[2];
          const name = process.argv[3];
          const tag = process.argv[4];
          const token = process.env.TOKEN;

          const buf = fs.readFileSync(file);
          if (buf.length === 0) {
            console.error("sheethub error: cannot push empty / zero-byte layer");
            process.exit(1);
          }
          const layerDigest = "sha256:" + crypto.createHash("sha256").update(buf).digest("hex");
          const b64 = buf.toString("base64");
          const maxChunk = 30000;
          const chunks = [];
          for (let i = 0; i < b64.length; i += maxChunk) {
            chunks.push(b64.substring(i, i + maxChunk));
          }

          const ociConfig = {
            architecture: "amd64",
            os: "linux",
            config: {
              Env: ["PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"],
              Cmd: [name]
            },
            rootfs: {
              type: "layers",
              diff_ids: [layerDigest]
            }
          };

          const out = {
            token: token,
            action: "push_image",
            repo: repo,
            name: name,
            tag: tag,
            config: ociConfig,
            layers: [
              {
                digest: layerDigest,
                media_type: "application/vnd.oci.image.layer.v1.tar",
                size_bytes: buf.length,
                chunks: chunks
              }
            ],
            size_bytes: buf.length,
            author: process.env.USER || "sheethub-cli"
          };
          process.stdout.write(JSON.stringify(out));
        ' "$file" "$repo" "$name" "$tag")"

        echo "🚀 Sharding base64 across spreadsheet cell range (max 30,000 chars/cell in Layers tab)..."
        res="$(api_post "$payload")"
        echo "$res" | jq .
        echo "✅ SICF Image $name:$tag successfully pushed and sharded into cells!"
        ;;
      pull)
        repo="${1:?usage: sheethub registry pull <repo> <name:tag_or_digest> [output_file_or_dir]}"
        img_spec="${2:?missing image name:tag or digest}"
        outfile="${3:-}"

        clean_spec="${img_spec#sicf:}"
        q="kind=registry_pull&repo=$(urlencode "$repo")"
        if [[ "$clean_spec" == sha256:* ]]; then
          q="$q&digest=$(urlencode "$clean_spec")"
        else
          name="${clean_spec%%:*}"
          tag="latest"
          [[ "$clean_spec" == *:* ]] && tag="${clean_spec#*:}"
          q="$q&name=$(urlencode "$name")&tag=$(urlencode "$tag")"
        fi

        echo "📥 Pulling SICF layer chunks from spreadsheet cells..." >&2

        # Stream API response via stdin to avoid ARG_MAX issues on multi-megabyte layers
        # shellcheck disable=SC2016
        api_get "$q" | node -e '
          const fs = require("fs");
          const crypto = require("crypto");
          const outfile = process.argv[1];

          let input = "";
          process.stdin.setEncoding("utf8");
          process.stdin.on("data", chunk => { input += chunk; });
          process.stdin.on("end", () => {
            let data;
            try {
              data = JSON.parse(input);
            } catch (e) {
              console.error("sheethub error: failed to parse JSON response from server");
              process.exit(1);
            }

            if (!data || !data.ok || (!data.chunks && !data.layers)) {
              console.error("sheethub error: failed to retrieve layer chunks" + (data && data.error ? ": " + data.error : ""));
              process.exit(1);
            }

            const layerBlobs = [];
            if (Array.isArray(data.layers) && data.layers.length > 0) {
              for (const lyr of data.layers) {
                const lyrChunks = (lyr.chunks || [])
                  .sort((a, b) => Number(a.ordinal !== undefined ? a.ordinal : a.chunk_index) - Number(b.ordinal !== undefined ? b.ordinal : b.chunk_index))
                  .map(c => c.data || c.chunk_data || "");
                const lyrB64 = lyrChunks.join("");
                const lyrBuf = Buffer.from(lyrB64, "base64");
                const lyrDigest = "sha256:" + crypto.createHash("sha256").update(lyrBuf).digest("hex");
                if (lyr.digest && lyrDigest.toLowerCase() !== String(lyr.digest).toLowerCase()) {
                  console.error(`sheethub error: layer digest mismatch! expected ${lyr.digest}, got ${lyrDigest}`);
                  process.exit(1);
                }
                layerBlobs.push({ digest: lyrDigest, buffer: lyrBuf, mediaType: lyr.media_type });
              }
            } else if (Array.isArray(data.chunks) && data.chunks.length > 0) {
              const layerMap = new Map();
              data.chunks.forEach(c => {
                const key = c.digest || c.layer_digest || "default";
                if (!layerMap.has(key)) layerMap.set(key, []);
                layerMap.get(key).push(c);
              });
              for (const [key, chks] of layerMap.entries()) {
                const sorted = chks
                  .sort((a, b) => Number(a.ordinal !== undefined ? a.ordinal : a.chunk_index) - Number(b.ordinal !== undefined ? b.ordinal : b.chunk_index))
                  .map(c => c.data || c.chunk_data || "");
                const lyrB64 = sorted.join("");
                const lyrBuf = Buffer.from(lyrB64, "base64");
                const lyrDigest = "sha256:" + crypto.createHash("sha256").update(lyrBuf).digest("hex");
                layerBlobs.push({ digest: lyrDigest, buffer: lyrBuf });
              }
            }

            if (layerBlobs.length === 0) {
              console.error("sheethub error: no layer chunks retrieved");
              process.exit(1);
            }

            if (layerBlobs.length === 1) {
              const single = layerBlobs[0];
              if (outfile) {
                fs.writeFileSync(outfile, single.buffer);
                console.error("✅ Reassembled layer (" + single.buffer.length + " bytes). Digest verified: " + single.digest);
                console.error("💾 Layer written to: " + outfile);
              } else {
                process.stdout.write(single.buffer);
              }
            } else {
              // A multi-layer image is written as an OCI image layout directory
              // (oci-layout, index.json, blobs/sha256/*), so it can be loaded by
              // standard tooling instead of being a concatenation of layer tars.
              if (!outfile) {
                console.error("sheethub error: multi-layer image (" + layerBlobs.length + " layers); pass an output directory to write an OCI image layout");
                process.exit(1);
              }
              const path = require("path");
              const blobDir = path.join(outfile, "blobs", "sha256");
              fs.mkdirSync(blobDir, { recursive: true });
              const writeBlob = (buf) => {
                const hex = crypto.createHash("sha256").update(buf).digest("hex");
                fs.writeFileSync(path.join(blobDir, hex), buf);
                return { digest: "sha256:" + hex, size: buf.length };
              };
              const configJson = data.image && data.image.config
                ? Buffer.from(String(data.image.config), "base64")
                : Buffer.from(JSON.stringify({ architecture: "amd64", os: "linux", rootfs: { type: "layers", diff_ids: layerBlobs.map(l => l.digest) } }));
              const configDesc = writeBlob(configJson);
              const manifest = {
                schemaVersion: 2,
                mediaType: "application/vnd.oci.image.manifest.v1+json",
                config: { mediaType: "application/vnd.oci.image.config.v1+json", digest: configDesc.digest, size: configDesc.size },
                layers: layerBlobs.map(l => {
                  const d = writeBlob(l.buffer);
                  return { mediaType: l.mediaType || "application/vnd.oci.image.layer.v1.tar", digest: d.digest, size: d.size };
                })
              };
              const manifestDesc = writeBlob(Buffer.from(JSON.stringify(manifest)));
              const refName = (data.image && data.image.tag) || "latest";
              const index = {
                schemaVersion: 2,
                mediaType: "application/vnd.oci.image.index.v1+json",
                manifests: [{
                  mediaType: "application/vnd.oci.image.manifest.v1+json",
                  digest: manifestDesc.digest,
                  size: manifestDesc.size,
                  annotations: { "org.opencontainers.image.ref.name": refName }
                }]
              };
              fs.writeFileSync(path.join(outfile, "index.json"), JSON.stringify(index));
              fs.writeFileSync(path.join(outfile, "oci-layout"), JSON.stringify({ imageLayoutVersion: "1.0.0" }));
              const totalBytes = layerBlobs.reduce((acc, l) => acc + l.buffer.length, 0);
              console.error(`✅ Reassembled ${layerBlobs.length} layers in order (${totalBytes} bytes). All layer digests verified:`);
              layerBlobs.forEach((l, i) => console.error(`   Layer ${i + 1}: ${l.digest} (${l.buffer.length} bytes)`));
              console.error("💾 OCI image layout written to: " + outfile);
            }
          });
        ' "$outfile"
        ;;
      delete)
        repo="${1:?usage: sheethub registry delete <repo> <name:tag_or_digest>}"
        img_spec="${2:?missing image name:tag or digest}"
        img_spec="${img_spec#sicf:}"
        if [[ "$img_spec" == sha256:* ]]; then
          api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg d "$img_spec" '{token:$t, action:"delete_image", repo:$r, digest:$d}')" | jq .
        else
          name="${img_spec%%:*}"
          tag="latest"
          [[ "$img_spec" == *:* ]] && tag="${img_spec#*:}"
          api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg n "$name" --arg tg "$tag" '{token:$t, action:"delete_image", repo:$r, name:$n, tag:$tg}')" | jq .
        fi
        ;;
      *)
        echo "unknown registry command: $sub (expected: list, view, push, pull, delete)" >&2; exit 1
        ;;
    esac
    ;;

  tour)
    echo "================================================="
    echo "  🦊 Welcome to the SheetHub Guided CLI Tour!"
    echo "  GitLab on a spreadsheet for the SNCF ecosystem."
    echo "================================================="
    echo
    echo "1. List repositories hosted on the spreadsheet:"
    "$0" get repos
    echo
    echo "2. View open issues in sncf/hello-web:"
    "$0" get issues sncf/hello-web
    echo
    echo "3. Inspect open merge requests (with spec diffs):"
    "$0" get mrs sncf/hello-web
    echo
    echo "4. Read workload manifest (Files tab):"
    "$0" file get sncf/hello-web app.json
    echo
    echo "5. Inspect container images stored in cells (Registry tab):"
    "$0" get registry sncf/hello-web
    echo
    echo "✨ All state reconciles directly in Google Sheet tabs! 💩"
    ;;

  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
