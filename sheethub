#!/usr/bin/env bash
#
# SheetHub — a GitLab-style DevOps forge whose data plane is a spreadsheet.
# CLI tool for repository metadata, issues, merge requests, releases, and manifests.
#
# Connects to the SheetHub Apps Script apiserver (or local mock server).
#
# Config via env (or a .sheethub.env / .skctl.env file next to this script):
#   SHEETHUB_URL=http://localhost:8788/exec
#   TOKEN=CHANGE_ME_super_secret
#
# Usage:
#   sheethub repo list
#   sheethub issue list <repo>
#   sheethub issue create <repo> <title> [body]
#   sheethub mr list <repo>
#   sheethub mr view <mr_id_or_number> [repo]
#   sheethub mr merge <mr_id_or_number> [repo]
#   sheethub file get <repo> <path>
#   sheethub file put <repo> <path> <local_file>
#   sheethub release list <repo>
#   sheethub tour
#
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
[ -f "$here/.sheethub.env" ] && . "$here/.sheethub.env"
[ -f "$here/.skctl.env" ] && [ -z "${SHEETHUB_URL:-}" ] && [ -n "${WEBAPP_URL:-}" ] && SHEETHUB_URL="$WEBAPP_URL"
SHEETHUB_URL="${SHEETHUB_URL:-http://localhost:8788/exec}"
TOKEN="${TOKEN:-CHANGE_ME_super_secret}"

command -v jq >/dev/null 2>&1 || { echo "sheethub: jq not found (install jq)" >&2; exit 1; }

urlencode() {
  jq -rn --arg v "$1" '$v|@uri'
}

api_get() {
  local query="$1"
  local res
  res="$(curl -fsSL -m 30 "$SHEETHUB_URL?token=$(urlencode "$TOKEN")&$query")"
  if echo "$res" | jq -e '.error' >/dev/null 2>&1; then
    echo "sheethub error: $(echo "$res" | jq -r .error)" >&2
    exit 1
  fi
  echo "$res"
}

api_post() {
  local payload="$1"
  local res
  res="$(curl -fsSL -m 30 -X POST "$SHEETHUB_URL" -H 'Content-Type: application/json' -d "$payload")"
  if echo "$res" | jq -e '.error' >/dev/null 2>&1; then
    echo "sheethub error: $(echo "$res" | jq -r .error)" >&2
    exit 1
  fi
  echo "$res"
}

cmd="${1:-help}"; shift || true

case "$cmd" in
  get)
    kind="${1:-repos}"
    case "$kind" in
      repos|repo)
        api_get "kind=repos" | jq -r '["NAME","DEFAULT_BRANCH","VISIBILITY","STARS","UPDATED"], (.items[]|[.name,.default_branch,.visibility,(.stars_count|tostring),.updated_at]) | @tsv' | column -t -s $'\t'
        ;;
      issues|issue)
        repo="${2:-}"
        q="kind=issues"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["#","REPO","STATE","AUTHOR","TITLE"], (.items[]|[.number,.repo,.state,.author,.title]) | @tsv' | column -t -s $'\t'
        ;;
      mrs|mr|mergerequests)
        repo="${2:-}"
        q="kind=mergerequests"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["!","REPO","BRANCHES","STATE","AUTHOR","TITLE"], (.items[]|[.number,.repo,(.source_branch + " -> " + .target_branch),.state,.author,.title]) | @tsv' | column -t -s $'\t'
        ;;
      releases|rel)
        repo="${2:-}"
        q="kind=releases"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["TAG","REPO","NAME","ASSETS"], (.items[]|[.tag_name,.repo,.name,.assets]) | @tsv' | column -t -s $'\t'
        ;;
      files|file)
        repo="${2:-}"
        q="kind=files"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq -r '["REPO","PATH","BRANCH","UPDATED"], (.items[]|[.repo,.path,.branch,.updated_at]) | @tsv' | column -t -s $'\t'
        ;;
      *)
        echo "unknown kind: $kind (expected: repos, issues, mrs, releases, files)" >&2; exit 1
        ;;
    esac
    ;;

  repo)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get repos ;;
      *) echo "unknown repo command: $sub" >&2; exit 1 ;;
    esac
    ;;

  issue)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get issues "$@" ;;
      create)
        repo="${1:?usage: sheethub issue create <repo> <title> [body]}"
        title="${2:?missing issue title}"
        body="${3:-}"
        api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg tit "$title" --arg b "$body" '{token:$t, action:"create_issue", repo:$r, title:$tit, body:$b}')" | jq .
        ;;
      *) echo "unknown issue command: $sub" >&2; exit 1 ;;
    esac
    ;;

  mr)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get mrs "$@" ;;
      view)
        id="${1:?usage: sheethub mr view <id_or_number> [repo]}"
        repo="${2:-}"
        q="kind=mergerequests&id=$(urlencode "$id")"
        [ -n "$repo" ] && q="$q&repo=$(urlencode "$repo")"
        api_get "$q" | jq '.items[0] // {error: "MR not found"}'
        ;;
      merge)
        id="${1:?usage: sheethub mr merge <mr_id_or_number> [repo]}"
        repo="${2:-}"
        api_post "$(jq -n --arg t "$TOKEN" --arg id "$id" --arg r "$repo" '{token:$t, action:"merge_mr", mr_id:$id, repo:$r}')" | jq .
        ;;
      *) echo "unknown mr command: $sub" >&2; exit 1 ;;
    esac
    ;;

  file)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get files "$@" ;;
      get)
        repo="${1:?usage: sheethub file get <repo> <path>}"
        path="${2:?missing file path}"
        res="$(api_get "kind=files&repo=$(urlencode "$repo")")"
        echo "$res" | jq -r --arg p "$path" '.items[] | select(.path == $p) | .content'
        ;;
      put)
        repo="${1:?usage: sheethub file put <repo> <path> <local_file>}"
        path="${2:?missing file path}"
        file="${3:?missing local file}"
        content="$(cat "$file")"
        api_post "$(jq -n --arg t "$TOKEN" --arg r "$repo" --arg p "$path" --arg c "$content" '{token:$t, action:"put_file", repo:$r, path:$p, content:$c}')" | jq .
        ;;
      *) echo "unknown file command: $sub" >&2; exit 1 ;;
    esac
    ;;

  release)
    sub="${1:-list}"; shift || true
    case "$sub" in
      list) "$0" get releases "$@" ;;
      *) echo "unknown release command: $sub" >&2; exit 1 ;;
    esac
    ;;

  tour)
    echo "================================================="
    echo "  🦊 Welcome to the SheetHub Guided CLI Tour!"
    echo "  GitLab on a spreadsheet for the SNCF ecosystem."
    echo "================================================="
    echo
    echo "1. List repositories hosted on the spreadsheet:"
    "$0" get repos
    echo
    echo "2. View open issues in sncf/hello-web:"
    "$0" get issues sncf/hello-web
    echo
    echo "3. Inspect open merge requests (with spec diffs):"
    "$0" get mrs sncf/hello-web
    echo
    echo "4. Read workload manifest (Files tab):"
    "$0" file get sncf/hello-web app.json
    echo
    echo "✨ All state reconciles directly in Google Sheet tabs! 💩"
    ;;

  *)
    grep '^#' "$0" | sed 's/^# \{0,1\}//'
    ;;
esac
